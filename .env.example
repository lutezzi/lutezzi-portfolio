# Production site URL (Vercel Environment Variables)
NEXT_PUBLIC_SITE_URL=https://lutezzi.space

# Web3Forms — https://web3forms.com (ücretsiz, ayda 250 form)
# Kayıt ol → Access Key al → buraya yapıştır
# NEXT_PUBLIC_ prefix gerekli — form tarayıcıdan doğrudan Web3Forms'a istek atar
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=your_access_key_here
